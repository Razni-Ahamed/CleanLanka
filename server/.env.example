MONGO_URI=your_atlas_connection_string
PORT=5000

# Signing key for JWTs. Use a long random string — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of sites allowed to call the API.
# Leave unset to allow any origin (fine for local development).
CLIENT_ORIGIN=http://localhost:5173

# Admin account created by `npm run seed`.
SEED_ADMIN_NAME=Municipal Admin
SEED_ADMIN_EMAIL=admin@cleanlk.lk
SEED_ADMIN_PASSWORD=change_this_password
